{
  "name": "mad-coder-pro",
  "displayName": "Mad Coder Pro",
  "version": "2.0.0",
  "description": "PDF-driven LeetCode gatekeeper with whitelist tab control.",
  "author": "Mad Coder",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.0",
    "@plasmohq/storage": "^1.13.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^4.8.69",
    "plasmo": "^0.89.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "storage",
      "alarms",
      "tabs",
      "webNavigation",
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess",
      "scripting",
      "notifications"
    ],
    "declarative_net_request": {
      "rule_resources": [
        {
          "id": "whitelist_rules",
          "enabled": true,
          "path": "assets/data/dnr_rules.json"
        }
      ]
    }
  }
}
